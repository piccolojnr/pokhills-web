---
import Base from '@/components/layout/Base.astro';
import BusinessStatus from '@/components/shared/BusinessStatus.astro';
import { enquiryLink, statusMessage } from '@/data/businesses';
---
<Base title="Pokhills Accommodation Enquiries" description="Accommodation bookings and payments at Pokhills Eco Garden are not available. Contact us with an enquiry about the coming-soon retreat.">
  <section class="page-intro wrap"><p class="eyebrow">Pokhills Eco Garden</p><BusinessStatus business="pokhills" /><h1>Stays are <em>coming soon.</em></h1><p>{statusMessage('pokhills')}</p><p>Accommodation bookings and payments are not available. Contact us for information about the upcoming retreat.</p><div class="actions"><a class="button" href={enquiryLink('pokhills')}>Enquire about Pokhills ↗</a><a class="text-link" href="/rooms">Explore Pokhills Stays ↗</a></div></section>
</Base>