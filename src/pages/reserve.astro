---
import Base from "@/components/layout/Base.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import ComingSoonBadge from "@/components/shared/ComingSoonBadge.astro";
import RoomCard from "@/components/rooms/RoomCard.astro";
import WaitlistForm from "@/components/forms/WaitlistForm";
import { getRooms } from "@/lib/api";

const rooms = await getRooms();
const previewRooms = [
  ...rooms.filter((r) => r.featured),
  ...rooms.filter((r) => !r.featured),
].slice(0, 3);

const whatsapp = import.meta.env.PUBLIC_WHATSAPP ?? "233202400666";
const waHref = `https://wa.me/${whatsapp.replace(/\D/g, "")}?text=${encodeURIComponent("Hi! I'd like to book a room at Pokhills Eco Garden.")}`;
---

<Base
  title="Reserve a Room — Pokhills Eco Garden"
  description="Room reservations at Pokhills Eco Garden are coming soon. Join the waitlist to be notified when online booking opens."
  noindex={true}
>
  <!-- Deep green bg throughout -->
  <div class="bg-green-deep min-h-screen">
    <!-- 1. Hero copy -->
    <section
      class="relative px-6 pt-24 pb-16 flex flex-col items-center text-center overflow-hidden"
    >
      <div
        class="texture absolute inset-0 pointer-events-none"
        aria-hidden="true"
      >
      </div>
      <div class="relative z-10 flex flex-col items-center gap-6 max-w-2xl">
        <SectionLabel text="Room reservations" color="ochre" />
        <h1
          class="font-display font-normal italic text-[44px] md:text-[52px] leading-[1.1] text-cream"
        >
          We're getting ready<br class="hidden sm:block" /> for you
        </h1>
        <p class="font-body text-sm text-stone/80 leading-relaxed max-w-md">
          Our online booking system is almost ready. Soon you'll be able to
          browse availability, choose your room, and confirm your stay in
          minutes — all without a phone call. In the meantime, we're just a
          WhatsApp away.
        </p>
        <ComingSoonBadge text="Online booking coming soon" />
      </div>
    </section>

    <!-- 2. Waitlist form -->
    <section class="px-6 pb-20 flex flex-col items-center">
      <div class="w-full max-w-md">
        <p
          class="font-body text-[10px] uppercase tracking-[0.2em] text-stone/50 text-center mb-6"
        >
          Get notified when we launch
        </p>
        <WaitlistForm interest="rooms" darkMode={true} client:load />
      </div>
    </section>

    <!-- 3. Book right now -->
    <section
      class="px-6 py-16 flex flex-col items-center text-center border-t border-stone/10"
    >
      <p
        class="font-body text-[11px] uppercase tracking-[0.16em] text-stone/50 mb-6"
      >
        Want to book right now?
      </p>
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 font-display text-[22px] md:text-[26px] text-ochre hover:text-ochre-light transition-colors duration-200"
      >
        <svg
          width="26"
          height="26"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"
          ></path>
        </svg>
        Chat with us on WhatsApp
      </a>
      <p class="font-body text-[13px] text-stone/50 mt-3">
        {whatsapp}
      </p>
    </section>

    <!-- 4. Room preview -->
    <section class="px-6 pt-8 pb-24 border-t border-stone/10">
      <div class="max-w-6xl mx-auto">
        <p
          class="font-body text-[10px] uppercase tracking-[0.2em] text-stone/40 text-center mb-8"
        >
          While you wait, explore the rooms
        </p>
        <!-- Horizontal scroll on mobile, grid on desktop -->
        <div
          class="flex gap-5 overflow-x-auto pb-4 md:grid md:grid-cols-3 md:overflow-visible md:pb-0"
        >
          {
            previewRooms.map((room) => (
              <div class="min-w-[280px] md:min-w-0 flex-shrink-0 md:flex-shrink">
                <RoomCard room={room} />
              </div>
            ))
          }
        </div>
        <div class="text-center mt-8">
          <a
            href="/rooms"
            class="inline-flex items-center gap-2 font-body text-[11px] uppercase tracking-[0.14em] text-stone/60 hover:text-ochre transition-colors duration-150"
          >
            View all rooms
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .texture {
    background-image: repeating-linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0.03) 0px,
      rgba(255, 255, 255, 0.03) 1px,
      transparent 1px,
      transparent 10px
    );
  }
</style>
