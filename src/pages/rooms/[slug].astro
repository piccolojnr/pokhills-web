---
import Base from "@/components/layout/Base.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import AmenityBadge from "@/components/rooms/AmenityBadge.astro";
import RoomCard from "@/components/rooms/RoomCard.astro";
import ComingSoonBadge from "@/components/shared/ComingSoonBadge.astro";
import RoomGallery from "@/components/rooms/RoomGallery";
import { getRooms } from "@/lib/api";
import { formatGHS } from "@/lib/utils";
import type { Room } from "@/lib/types";

export async function getStaticPaths() {
  const rooms = await getRooms();
  return rooms.map((room) => ({
    params: { slug: room.slug },
    props: { room },
  }));
}

interface Props {
  room: Room;
}

const { room } = Astro.props;

const allRooms = await getRooms();
const otherRooms = [
  ...allRooms.filter((r) => r.slug !== room.slug && r.featured),
  ...allRooms.filter((r) => r.slug !== room.slug && !r.featured),
].slice(0, 2);

const typeLabel: Record<Room["type"], string> = {
  suite: "Suite",
  standard: "Standard room",
  cabin: "Cabin",
  deluxe: "Deluxe",
};

const whatsapp = import.meta.env.PUBLIC_WHATSAPP ?? "+233000000000";
const waHref = `https://wa.me/${whatsapp.replace(/\D/g, "")}?text=${encodeURIComponent(`Hi! I'm interested in booking ${room.name} at Pokhills Eco Garden.`)}`;
---

<Base title={`${room.name} — Pokhills Eco Garden`} description={room.tagline}>
  <!-- 1. Breadcrumb + header -->
  <section class="bg-cream pt-10 pb-0 px-6">
    <div class="max-w-6xl mx-auto">
      <!-- Breadcrumb -->
      <nav
        class="flex items-center gap-2 font-body text-[10px] uppercase tracking-[0.16em] text-muted mb-8"
        aria-label="Breadcrumb"
      >
        <a href="/" class="hover:text-ochre transition-colors duration-150"
          >Home</a
        >
        <span aria-hidden="true">/</span>
        <a href="/rooms" class="hover:text-ochre transition-colors duration-150"
          >Rooms</a
        >
        <span aria-hidden="true">/</span>
        <span class="text-bark">{room.name}</span>
      </nav>

      <!-- Two-column layout: gallery left, sticky detail card right -->
      <div
        class="grid grid-cols-1 lg:grid-cols-[1fr_340px] gap-10 lg:gap-16 items-start"
      >
        <!-- Gallery -->
        <div>
          <RoomGallery images={room.images} roomName={room.name} client:load />
        </div>

        <!-- Sticky detail card -->
        <div class="lg:sticky lg:top-24 flex flex-col gap-6">
          <!-- Type + featured badges -->
          <div class="flex items-center gap-2">
            <span
              class="font-body text-[9px] uppercase tracking-[0.14em] bg-green-deep text-stone px-2.5 py-1 rounded-sm"
            >
              {typeLabel[room.type]}
            </span>
            {
              room.featured && (
                <span class="font-body text-[9px] uppercase tracking-[0.14em] bg-ochre text-cream px-2.5 py-1 rounded-sm">
                  Featured
                </span>
              )
            }
          </div>

          <!-- Name + tagline -->
          <div>
            <h1
              class="font-display font-normal text-[38px] md:text-[44px] leading-[1.1] text-bark"
            >
              {room.name}
            </h1>
            <p
              class="font-display italic text-[17px] text-stone/80 mt-2 leading-snug"
            >
              {room.tagline}
            </p>
          </div>

          <!-- Rate -->
          <div
            class="border-t border-b border-stone/20 py-5 flex items-end justify-between"
          >
            <div>
              <span
                class="font-body text-[10px] uppercase tracking-[0.14em] text-muted block mb-1"
              >
                From
              </span>
              <span class="font-display text-[32px] text-bark leading-none">
                {formatGHS(room.publicRate)}
              </span>
              <span class="font-body text-sm text-muted"> / night</span>
            </div>
            <ComingSoonBadge text="Online booking soon" />
          </div>

          <!-- CTA buttons -->
          <div class="flex flex-col gap-3">
            <a
              href={waHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 font-body text-[11px] uppercase tracking-[0.14em] text-cream bg-ochre px-6 py-3.5 rounded-sm transition-colors duration-200 hover:bg-ochre-light"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"
                ></path>
              </svg>
              Reserve via WhatsApp
            </a>
            <a
              href={`tel:${whatsapp.replace(/\s/g, "")}`}
              class="inline-flex items-center justify-center font-body text-[11px] uppercase tracking-[0.14em] text-bark border border-stone/40 px-6 py-3.5 rounded-sm transition-colors duration-200 hover:border-bark/60 hover:bg-stone/20"
            >
              Call us
            </a>
          </div>

          <!-- Trust note -->
          <p class="font-body text-[11px] text-muted leading-relaxed">
            Reservations confirmed via WhatsApp. A 50% deposit secures your
            room.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Description -->
  <section class="bg-cream py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl">
        <SectionLabel text="About this room" color="stone" />
        <p class="reveal font-body text-base text-muted leading-relaxed mt-5" data-reveal="fade">
          {room.description}
        </p>
      </div>
    </div>
  </section>

  <!-- 3. Amenities -->
  <section class="bg-stone py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <SectionLabel text="What's included" color="stone" />
      <h2
        class="font-display font-normal text-[28px] text-bark mt-3 mb-8 leading-tight"
      >
        Room amenities
      </h2>
      <div class="flex flex-wrap gap-2.5">
        {room.amenities.map((amenity) => <AmenityBadge label={amenity} />)}
      </div>
    </div>
  </section>

  <!-- 4. Other rooms -->
  {
    otherRooms.length > 0 && (
      <section class="bg-cream py-20 px-6">
        <div class="max-w-6xl mx-auto">
          <SectionLabel text="Also at Pokhills" color="stone" />
          <h2 class="font-display font-normal text-[28px] text-bark mt-3 mb-8 leading-tight">
            Other rooms
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl">
            {otherRooms.map((r) => (
              <RoomCard room={r} />
            ))}
          </div>
          <div class="mt-8">
            <a
              href="/rooms"
              class="inline-flex items-center gap-2 font-body text-[11px] uppercase tracking-[0.14em] text-ochre border border-ochre px-6 py-3 rounded-sm transition-colors duration-200 hover:bg-ochre hover:text-cream"
            >
              View all rooms
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- 5. Reserve CTA -->
  <section
    class="bg-green-deep py-20 px-6 flex flex-col items-center text-center gap-5"
  >
    <SectionLabel text="Ready to stay?" color="cream" />
    <h2
      class="font-display font-normal text-[32px] md:text-[38px] leading-[1.1] text-cream"
    >
      Book {room.name}
    </h2>
    <p class="font-body text-sm text-stone max-w-sm leading-relaxed">
      Reach out via WhatsApp to check availability and reserve your stay. We
      respond within a few hours.
    </p>
    <a
      href={waHref}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 font-body text-[11px] uppercase tracking-[0.14em] text-cream bg-ochre px-8 py-3.5 rounded-sm transition-colors duration-200 hover:bg-ochre-light mt-2"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"
        ></path>
      </svg>
      WhatsApp us
    </a>
  </section>
</Base>
