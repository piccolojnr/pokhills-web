---
import Base from '@/components/layout/Base.astro';
import { getRooms } from '@/lib/api';
import { statusMessage, statusLabel, enquiryLink } from '@/data/businesses';
export async function getStaticPaths() {
  const rooms = await getRooms();
  return rooms.map(room => ({ params: { slug: room.slug } }));
}
---
<Base title="Pokhills Accommodation — Coming Soon" description="Pokhills Eco Garden accommodation is coming soon. Room rates, availability, bookings and payments are not available.">
  <section class="page-intro wrap"><img class="stay-logo" src="/brand/pokhills-logo-transparent.webp" alt="Pokhills Eco Garden" width="110" height="110" /><p class="eyebrow">{statusLabel('pokhills')}</p><h1>Pokhills Eco Garden</h1><p>{statusMessage('pokhills')}</p><p>Room details will be shared once confirmed. Accommodation bookings and payments are not available.</p><div class="actions"><a class="button" href="/rooms">Discover Pokhills Stays ↗</a><a class="text-link" href={enquiryLink('pokhills')}>Make an enquiry ↗</a></div></section>
</Base>
