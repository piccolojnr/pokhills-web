---
import Base from '@/components/layout/Base.astro';
import SectionLabel from '@/components/shared/SectionLabel.astro';
import RoomCard from '@/components/rooms/RoomCard.astro';
import ComingSoonBadge from '@/components/shared/ComingSoonBadge.astro';
import { getRooms, getSiteContent } from '@/lib/api';
import { getContent } from '@/lib/utils';

const rooms = await getRooms();
const content = await getSiteContent();

// Featured rooms first
const sortedRooms = [
  ...rooms.filter(r => r.featured),
  ...rooms.filter(r => !r.featured),
];

const whatsapp = import.meta.env.PUBLIC_WHATSAPP ?? '+233000000000';
const waHref = `https://wa.me/${whatsapp.replace(/\D/g, '')}`;
---

<Base
  title="Rooms & Stay"
  description="Five boutique rooms set within the garden estate at Pokhills Eco Garden, Pokrom, Ghana."
>

  <!-- 1. Page Hero -->
  <section class="page-hero relative flex flex-col items-center justify-center min-h-[40vh] bg-green-deep overflow-hidden px-6 text-center">
    <div class="texture absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="relative z-10 flex flex-col items-center gap-4">
      <SectionLabel text="Where you'll sleep" color="cream" />
      <h1 class="font-display font-normal text-[48px] leading-[1.1] text-cream">
        The rooms
      </h1>
      <p class="font-display italic text-[18px] text-stone/80">
        Five boutique rooms set within the garden estate
      </p>
    </div>
  </section>

  <!-- 2. Intro strip -->
  <section class="bg-cream py-14 px-6 text-center">
    <p class="font-body text-base text-muted leading-relaxed max-w-2xl mx-auto">
      {getContent(content, 'about.rooms_intro', 'Each room at Pokhills has its own character and its own view of the garden. Built with rammed earth, reclaimed timber, and local stone — designed to feel rooted in the land rather than imposed upon it. No two rooms are the same.')}
    </p>
  </section>

  <!-- 3. Rooms grid -->
  <section class="bg-cream pb-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedRooms.map(room => (
          <RoomCard room={room} />
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Amenities overview -->
  <section class="bg-stone py-20 px-6">
    <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">

      <!-- Left: Shared amenities -->
      <div>
        <h3 class="font-display text-[26px] font-normal text-bark leading-tight mb-6">
          Shared amenities
        </h3>
        <ul class="flex flex-col gap-4">
          {[
            {
              label: 'Free Wi-Fi',
              sub: 'Throughout the estate',
              icon: `<path d="M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>`,
            },
            {
              label: 'Secure parking',
              sub: 'Gated estate grounds',
              icon: `<rect x="1" y="3" width="15" height="13" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M16 8h4l3 4v5h-7V8z" stroke="currentColor" stroke-width="1.5" fill="none"/><circle cx="5.5" cy="18.5" r="2.5" stroke="currentColor" stroke-width="1.5" fill="none"/><circle cx="18.5" cy="18.5" r="2.5" stroke="currentColor" stroke-width="1.5" fill="none"/>`,
            },
            {
              label: 'Garden access',
              sub: 'Twelve acres, open all day',
              icon: `<path d="M12 22V12m0 0C12 7 7 3 2 3c0 5 4 9 10 9zm0 0c0-5 5-9 10-9-1 5-5 9-10 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>`,
            },
            {
              label: 'Bar access',
              sub: 'Pokrom Garden Bar, Tue–Sun',
              icon: `<path d="M8 22h8M7 10h10l-1 7H8l-1-7zM5 5h14l-1 5H6L5 5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>`,
            },
            {
              label: 'Breakfast available',
              sub: 'Served on request',
              icon: `<path d="M18 8h1a4 4 0 0 1 0 8h-1M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8zM6 1v3M10 1v3M14 1v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>`,
            },
          ].map(({ label, sub, icon }) => (
            <li class="flex items-start gap-3.5">
              <span class="shrink-0 mt-0.5 text-ochre">
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
              </span>
              <span>
                <span class="block font-body text-sm font-normal text-bark">{label}</span>
                <span class="block font-body text-[11px] text-muted mt-0.5">{sub}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Right: Your stay includes -->
      <div>
        <h3 class="font-display text-[26px] font-normal text-bark leading-tight mb-6">
          Your stay includes
        </h3>
        <ul class="flex flex-col gap-4">
          {[
            {
              label: 'Daily housekeeping',
              sub: 'Rooms serviced each morning',
              icon: `<path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>`,
            },
            {
              label: 'Fresh linens',
              sub: 'Changed daily on request',
              icon: `<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>`,
            },
            {
              label: 'Towels',
              sub: 'Bath and pool towels provided',
              icon: `<rect x="2" y="7" width="20" height="14" rx="2" ry="2" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" stroke="currentColor" stroke-width="1.5" fill="none"/>`,
            },
            {
              label: 'Welcome drink',
              sub: 'Hibiscus zobo or palm wine on arrival',
              icon: `<path d="M8 22h8M7 10h10l-1 7H8l-1-7zM5 5h14l-1 5H6L5 5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>`,
            },
          ].map(({ label, sub, icon }) => (
            <li class="flex items-start gap-3.5">
              <span class="shrink-0 mt-0.5 text-ochre">
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
              </span>
              <span>
                <span class="block font-body text-sm font-normal text-bark">{label}</span>
                <span class="block font-body text-[11px] text-muted mt-0.5">{sub}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </section>

  <!-- 5. Reserve CTA -->
  <section class="bg-green-deep py-24 px-6 flex flex-col items-center text-center gap-6">

    <h2 class="font-display font-normal text-[36px] md:text-[42px] leading-[1.1] text-cream">
      Ready to stay?
    </h2>

    <ComingSoonBadge text="Online booking coming soon" />

    <p class="font-body text-sm text-stone max-w-sm leading-relaxed">
      Online booking coming soon. Contact us directly to reserve your room.
    </p>

    <div class="flex flex-wrap gap-4 justify-center mt-2">
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 font-body text-[11px] uppercase tracking-[0.14em] text-cream bg-ochre px-8 py-3.5 rounded-sm transition-colors duration-200 hover:bg-ochre-light"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
        </svg>
        WhatsApp us
      </a>
      <a
        href={`tel:${whatsapp.replace(/\s/g, '')}`}
        class="font-body text-[11px] uppercase tracking-[0.14em] text-cream border border-cream/30 px-8 py-3.5 rounded-sm transition-colors duration-200 hover:border-cream/60 hover:bg-white/5"
      >
        Call us
      </a>
    </div>

  </section>

</Base>

<style>
  .texture {
    background-image: repeating-linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0.03) 0px,
      rgba(255, 255, 255, 0.03) 1px,
      transparent 1px,
      transparent 10px
    );
  }
</style>
