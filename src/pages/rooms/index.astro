---
import Base from '@/components/layout/Base.astro';
import BusinessStatus from '@/components/shared/BusinessStatus.astro';
import GardenPlaceholder from '@/components/shared/GardenPlaceholder.astro';
import { statusMessage, enquiryLink } from '@/data/businesses';
---
<Base title="Pokhills Stays — Accommodation Coming Soon" description="Pokhills Eco Garden is preparing a separate accommodation experience in Pokrom Nsabaa, Ghana. Accommodation bookings and payments are not available.">
  <section class="stays-intro"><div class="wrap"><img src="/brand/pokhills-logo-transparent.webp" alt="Pokhills Eco Garden logo" width="130" height="130" /><p class="eyebrow">Pokhills Eco Garden</p><BusinessStatus business="pokhills" /><h1>A little more quiet.<br /><em>A little closer to nature.</em></h1><p>A garden retreat is taking shape in Pokrom Nsabaa, Ghana. Pokhills Eco Garden is our accommodation brand, with its own identity and a different way to experience this special place.</p></div></section>
  <section class="section wrap story-grid"><GardenPlaceholder label="Pokhills accommodation · Photography coming soon" variant="olive" /><div class="prose"><p class="eyebrow">Room to slow down</p><h2>Something worth<br /><em>looking forward to.</em></h2><p>{statusMessage('pokhills')}</p><p>Room details and an opening date will be shared once confirmed. We are not accepting accommodation bookings or payments.</p><a class="button" href={enquiryLink('pokhills')} target="_blank" rel="noopener noreferrer">Enquire about Pokhills ↗</a><p class="small-note">This opens a direct enquiry. It does not reserve a room.</p></div></section>
  <section class="offer-section"><div class="section wrap story-grid"><div><p class="eyebrow">Two experiences. One garden destination.</p><h2>While the retreat takes shape,<br /><em>meet Pokrom Eco Bar.</em></h2></div><div class="prose"><p>Pokrom Eco Bar is the separate food and drinks destination at the same property. See its current opening status and discover what’s planned.</p><a class="text-link" href="/restaurant">Discover Pokrom Eco Bar ↗</a></div></div></section>
</Base>
