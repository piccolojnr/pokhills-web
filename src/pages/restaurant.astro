---
import Base from '@/components/layout/Base.astro';
import BusinessStatus from '@/components/shared/BusinessStatus.astro';
import InspirationPhoto from '@/components/shared/InspirationPhoto.astro';
import { businesses, statusMessage, enquiryLink, property } from '@/data/businesses';
---
<Base title="Discover Pokrom Eco Bar" description="Get to know Pokrom Eco Bar: food, refreshing drinks and good company in a garden setting in Pokrom Nsabaa, Ghana. Check our opening status before visiting.">
  <section class="page-intro wrap"><p class="eyebrow">Nature · Taste · Experience</p><BusinessStatus /><h1>Good company.<br /><em>A garden to call your own.</em></h1><p>Welcome to Pokrom Eco Bar, a destination for food, drinks and moments together, surrounded by nature.</p></section>
  <section class="wrap story-grid section"><InspirationPhoto photo="evening" /><div class="prose"><p class="eyebrow">About Pokrom</p><h2>More than a place<br /><em>to raise a glass.</em></h2><p>We’re bringing together the simple pleasures: a refreshing drink, local food and the company of people you love. All in a relaxed garden atmosphere.</p><p>Pokrom Eco Bar has its own identity and experience. We share our garden destination with Pokhills Eco Garden, the separate accommodation business being prepared for a later launch.</p><a class="text-link" href="/menu">Explore food & drinks ↗</a></div></section>
  <section class="offer-section"><div class="wrap section story-grid"><div><p class="eyebrow">Before you visit</p><h2>A warm welcome<br /><em>is taking shape.</em></h2></div><div class="prose"><BusinessStatus /><p>{statusMessage('pokrom')}</p><p>{businesses.pokrom.hours ?? 'Operating hours have not been confirmed yet.'}</p><div class="actions"><a class="button" href={enquiryLink('pokrom')} target="_blank" rel="noopener noreferrer">Enquire about Pokrom ↗</a><a class="text-link" href={property.maps} target="_blank" rel="noopener noreferrer">Get directions ↗</a></div><p class="small-note">Online table reservations are not available. Contact us for information.</p></div></div></section>
</Base>
