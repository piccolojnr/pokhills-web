---
import Base from '@/components/layout/Base.astro';
import BusinessStatus from '@/components/shared/BusinessStatus.astro';
import { property, businesses, enquiryLink, statusMessage } from '@/data/businesses';
import ContactForm from '@/components/forms/ContactForm';
const liveContact = import.meta.env.PUBLIC_API_MODE === 'live' && !!import.meta.env.PUBLIC_API_URL;
---
<Base title="Location & Contact" description="Find Pokrom Eco Bar and Pokhills Eco Garden in Pokrom Nsabaa, Ghana. Get directions, check opening information, or contact us directly.">
  <section class="page-intro wrap"><p class="eyebrow">Find your way to the garden</p><h1>Let’s <em>stay in touch.</em></h1><p>For questions about Pokrom Eco Bar or the future Pokhills Eco Garden stays, get in touch. Please check the opening information before planning a visit.</p></section>
  <section class="section wrap contact-grid"><div class="location-card"><span class="location-symbol" aria-hidden="true">⌖</span><p class="eyebrow">Pokrom Nsabaa · Ghana</p><h2>A little closer<br /><em>to the garden.</em></h2><address>{property.address}</address><a class="button" href={property.maps} target="_blank" rel="noopener noreferrer">Open in Google Maps ↗</a><p class="small-note">Open the location in Google Maps for directions.</p></div><div class="contact-details"><p class="eyebrow">Get in touch</p><h2>We’d love to <em>hear from you.</em></h2><a class="contact-email" href={`mailto:${property.email}`}>{property.email}</a>{property.whatsapp && <a class="text-link" href={enquiryLink('pokrom')} target="_blank" rel="noopener noreferrer">WhatsApp +{property.whatsapp} ↗</a>}{(['pokrom', 'pokhills'] as const).map(id => <div class="contact-business"><h3>{businesses[id].name}</h3><BusinessStatus business={id} /><p>{statusMessage(id)}</p><p>{businesses[id].hours ?? 'Operating hours will be announced once confirmed.'}</p><a class="text-link" href={enquiryLink(id)} target="_blank" rel="noopener noreferrer">Enquire about {businesses[id].name} ↗</a></div>)}</div></section>
  {liveContact && <section class="section wrap"><h2>Send an enquiry</h2><ContactForm client:visible /></section>}
</Base>