---
import Base from '@/components/layout/Base.astro';
import BusinessStatus from '@/components/shared/BusinessStatus.astro';
import { enquiryLink } from '@/data/businesses';
import { menuCategories, publishedProducts } from '@/data/pokrom-menu';
---
<Base title="Food & Drinks" description="Explore food and drinks at Pokrom Eco Bar. Our confirmed menu and prices will be published here when ready.">
  <section class="page-intro wrap"><p class="eyebrow">Pokrom Eco Bar</p><BusinessStatus /><h1>Good taste.<br /><em>Great surroundings.</em></h1><p>Something refreshing. Something to share. A menu made for time together in the garden.</p></section>
  {!publishedProducts.length && <section class="menu-notice wrap"><span aria-hidden="true">✳</span><h2>Menu Coming Soon</h2><p>We’re putting the finishing touches on our food and drinks selection. Confirmed dishes, drinks and prices will appear here when ready.</p><a class="text-link" href={enquiryLink('pokrom')} target="_blank" rel="noopener noreferrer">Ask about the menu ↗</a></section>}
  <section class="section wrap"><p class="eyebrow">{publishedProducts.length ? 'Explore our menu' : 'Planned menu categories'}</p><div class="menu-categories">{menuCategories.map(category => <section class="menu-category" id={category.id}><div><h2>{category.name}</h2><p>{category.note}</p></div><div>{publishedProducts.filter(item => item.categoryId === category.id).map(item => <article class="menu-product"><h3>{item.name}</h3><p>{item.description}</p>{item.price !== null && <p>{new Intl.NumberFormat('en-GH', { style: 'currency', currency: item.currency }).format(item.price)}</p>}</article>)}{!publishedProducts.some(item => item.categoryId === category.id) && <span class="small-note">Selection coming soon</span>}</div></section>)}</div></section>
</Base>
