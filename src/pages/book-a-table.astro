---
import Base from '@/components/layout/Base.astro';
import BusinessStatus from '@/components/shared/BusinessStatus.astro';
import { enquiryLink, statusMessage } from '@/data/businesses';
---
<Base title="Pokrom Eco Bar Enquiries" description="Contact Pokrom Eco Bar for visitor information. Online table reservations are not available.">
  <section class="page-intro wrap"><p class="eyebrow">Pokrom Eco Bar</p><BusinessStatus /><h1>Let’s <em>talk Pokrom.</em></h1><p>{statusMessage('pokrom')}</p><p>Online table reservations are not available. Contact us for visitor information.</p><div class="actions"><a class="button" href={enquiryLink('pokrom')}>Enquire about Pokrom ↗</a><a class="text-link" href="/menu">Explore food & drinks ↗</a></div></section>
</Base>
