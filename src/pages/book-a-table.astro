---
import Base from '@/components/layout/Base.astro';
import SectionLabel from '@/components/shared/SectionLabel.astro';
import ComingSoonBadge from '@/components/shared/ComingSoonBadge.astro';
import PlaceholderImage from '@/components/shared/PlaceholderImage.astro';
import WaitlistForm from '@/components/forms/WaitlistForm';

const whatsapp = import.meta.env.PUBLIC_WHATSAPP ?? '+233000000000';
const waHref = `https://wa.me/${whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent("Hi! I'd like to reserve a table at Pokrom Garden Bar.")}`;
---

<Base
  title="Book a Table — Pokrom Garden Bar"
  description="Table reservations at Pokrom Garden Bar are coming soon. Join the waitlist or WhatsApp us to book now."
  noindex={true}
>

  <!-- Dark bark bg throughout -->
  <div class="bg-bark min-h-screen">

    <!-- 1. Hero copy -->
    <section class="relative px-6 pt-24 pb-16 flex flex-col items-center text-center overflow-hidden">
      <div class="texture absolute inset-0 pointer-events-none" aria-hidden="true"></div>
      <div class="relative z-10 flex flex-col items-center gap-6 max-w-2xl">
        <SectionLabel text="Pokrom Garden Bar" color="ochre" />
        <h1 class="font-display font-normal italic text-[44px] md:text-[52px] leading-[1.1] text-cream">
          Table reservations<br class="hidden sm:block" /> coming soon
        </h1>
        <p class="font-body text-sm text-stone/80 leading-relaxed max-w-md">
          Online table booking for Pokrom Garden Bar is in the works. When it launches, you'll be able to pick your date, choose your preferred spot on the terrace or inside, and confirm instantly. For now, we're happy to take bookings over WhatsApp.
        </p>
        <ComingSoonBadge text="Online booking coming soon" />
      </div>
    </section>

    <!-- 2. Waitlist form -->
    <section class="px-6 pb-16 flex flex-col items-center">
      <div class="w-full max-w-md">
        <p class="font-body text-[10px] uppercase tracking-[0.2em] text-stone/50 text-center mb-6">
          Be the first to know
        </p>
        <WaitlistForm interest="restaurant" darkMode={true} client:load />
      </div>
    </section>

    <!-- 3. Book right now -->
    <section class="px-6 py-16 flex flex-col items-center text-center border-t border-stone/10">
      <p class="font-body text-[11px] uppercase tracking-[0.16em] text-stone/50 mb-6">
        Reserve a table today
      </p>
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 font-display text-[22px] md:text-[26px] text-ochre hover:text-ochre-light transition-colors duration-200"
      >
        <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
        </svg>
        Chat with us on WhatsApp
      </a>
      <p class="font-body text-[13px] text-stone/50 mt-3">
        {whatsapp}
      </p>
    </section>

    <!-- 4. Decorative image + menu CTA -->
    <section class="px-6 pt-8 pb-24 border-t border-stone/10">
      <div class="max-w-3xl mx-auto flex flex-col items-center gap-10">

        <!-- Atmospheric placeholder -->
        <div class="w-full max-w-xl rounded-sm overflow-hidden">
          <PlaceholderImage tone="ochre" aspect="16/7" label="Pokrom Garden Bar" />
        </div>

        <!-- Menu CTA -->
        <div class="flex flex-col items-center gap-4 text-center">
          <p class="font-body text-[10px] uppercase tracking-[0.2em] text-stone/40">
            View the menu while you wait
          </p>
          <a
            href="/menu"
            class="inline-flex items-center gap-2 font-body text-[11px] uppercase tracking-[0.14em] text-cream bg-ochre px-8 py-3.5 rounded-sm transition-colors duration-200 hover:bg-ochre-light"
          >
            See the menu
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a
            href="/restaurant"
            class="font-body text-[11px] text-stone/40 hover:text-stone/70 transition-colors duration-150"
          >
            About the restaurant →
          </a>
        </div>

      </div>
    </section>

  </div>

</Base>

<style>
  .texture {
    background-image: repeating-linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0.025) 0px,
      rgba(255, 255, 255, 0.025) 1px,
      transparent 1px,
      transparent 10px
    );
  }
</style>
