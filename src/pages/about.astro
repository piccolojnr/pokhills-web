---
import Base from '@/components/layout/Base.astro';
import SectionLabel from '@/components/shared/SectionLabel.astro';
import PlaceholderImage from '@/components/shared/PlaceholderImage.astro';
import RichText from '@/components/shared/RichText.astro';
import { getSiteContent, getRooms } from '@/lib/api';
import { getContent } from '@/lib/utils';

const content = await getSiteContent();
const rooms   = await getRooms();

// Build story HTML from numbered paragraphs
const storyParagraphs = [1, 2, 3]
  .map(n => getContent(content, `about.story.${n}`, ''))
  .filter(Boolean)
  .map(p => `<p>${p}</p>`)
  .join('');

// Parse values JSON
interface Value { title: string; body: string; }
let values: Value[] = [];
try {
  const raw = getContent(content, 'about.values', '[]');
  values = JSON.parse(raw);
} catch { /* keep empty */ }
---

<Base
  title="About — Pokhills Eco Garden"
  description="The story behind Pokhills Eco Garden — a boutique eco-retreat and garden bar in Pokrom, Ghana."
>

  <!-- 1. Hero -->
  <section class="relative flex flex-col items-center justify-center min-h-[50vh] bg-green-deep overflow-hidden px-6 text-center">

    <!-- Atmospheric background image -->
    <div class="absolute inset-0 opacity-20">
      <PlaceholderImage tone="green" aspect="16/9" label="" />
    </div>

    <!-- Texture -->
    <div class="texture absolute inset-0 pointer-events-none" aria-hidden="true"></div>

    <!-- Content -->
    <div class="relative z-10 flex flex-col items-center gap-5 py-20 max-w-2xl">
      <SectionLabel text="Our story" color="stone" />
      <h1 class="font-display font-normal text-[44px] md:text-[52px] leading-[1.1] text-cream">
        The garden behind<br class="hidden sm:block" /> the garden
      </h1>
      <p class="font-display italic text-[17px] md:text-[19px] text-stone/80 leading-relaxed max-w-lg">
        {getContent(content, 'about.intro', 'Pokhills Eco Garden began as a small plot of land and a stubborn belief that hospitality and the natural world don\'t have to be in conflict.')}
      </p>
    </div>
  </section>

  <!-- 2. Story section -->
  <section class="bg-cream py-20 px-6">
    <div class="max-w-[720px] mx-auto">
      <h2 class="font-display font-normal text-[36px] text-bark leading-tight mb-3">
        How Pokhills came to be
      </h2>
      <div class="w-8 h-0.5 bg-ochre mb-8"></div>
      <div class="story-body font-body font-light text-base text-muted leading-[1.9]">
        <RichText content={storyParagraphs} />
      </div>
    </div>
  </section>

  <!-- 3. Two experiences -->
  <section class="bg-stone py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <SectionLabel text="Two experiences, one estate" color="ochre" />
      <h2 class="font-display font-normal text-[30px] text-bark leading-tight mt-3 mb-10">
        What we offer
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Pokrom Garden Bar -->
        <div class="bg-cream border-t-[3px] border-ochre p-7 flex flex-col gap-4">
          <h3 class="font-display font-normal text-[24px] text-bark leading-tight">
            Pokrom Garden Bar
          </h3>
          <p class="font-body font-light text-[14px] text-muted leading-relaxed flex-1">
            Open to guests and visitors alike. The terrace, the kitchen, the bar — built for lingering. Fresh food, local drinks, and a terrace that earns its keep when the sun goes down.
          </p>
          <a
            href="/menu"
            class="inline-flex items-center gap-1.5 font-body text-[11px] uppercase tracking-[0.14em] text-ochre hover:text-ochre-light transition-colors duration-150 self-start"
          >
            View menu
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <!-- The Stay -->
        <div class="bg-cream border-t-[3px] border-green-deep p-7 flex flex-col gap-4">
          <h3 class="font-display font-normal text-[24px] text-bark leading-tight">
            Pokhills Eco Garden Stay
          </h3>
          <p class="font-body font-light text-[14px] text-muted leading-relaxed flex-1">
            {rooms.length} boutique rooms built with rammed earth, reclaimed timber, and local stone. Each one different. Each one part of the garden rather than imposed upon it.
          </p>
          <a
            href="/rooms"
            class="inline-flex items-center gap-1.5 font-body text-[11px] uppercase tracking-[0.14em] text-green-deep hover:opacity-70 transition-opacity duration-150 self-start"
          >
            See the rooms
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- 4. Values -->
  {values.length > 0 && (
    <section class="bg-cream py-20 px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-normal text-[30px] text-bark leading-tight text-center mb-10">
          What we care about
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {values.map(({ title, body }, i) => (
            <div class="reveal border-l-[3px] border-ochre bg-cream pl-6 pr-4 py-6" data-reveal="fade" data-reveal-delay={String(i * 100)}>
              <h4 class="font-body font-medium text-[15px] text-bark mb-2 leading-snug">
                {title}
              </h4>
              <p class="font-body font-light text-[13px] text-muted leading-relaxed">
                {body}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 5. CTA -->
  <section class="bg-green-deep py-24 px-6 flex flex-col items-center text-center gap-6">
    <div class="texture absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="relative z-10 flex flex-col items-center gap-6">
      <SectionLabel text="Visit us" color="stone" />
      <h2 class="font-display font-normal text-[34px] md:text-[40px] leading-[1.1] text-cream">
        Come and see for yourself
      </h2>
      <p class="font-body text-sm text-stone/80 max-w-sm leading-relaxed">
        The estate is best experienced in person. Come for a meal, stay the night, or just wander the garden for an afternoon.
      </p>
      <div class="flex flex-wrap gap-4 justify-center mt-2">
        <a
          href="/rooms"
          class="font-body text-[11px] uppercase tracking-[0.14em] text-cream bg-ochre px-8 py-3.5 rounded-sm transition-colors duration-200 hover:bg-ochre-light"
        >
          Explore rooms
        </a>
        <a
          href="/contact"
          class="font-body text-[11px] uppercase tracking-[0.14em] text-cream border border-cream/30 px-8 py-3.5 rounded-sm transition-colors duration-200 hover:border-cream/60 hover:bg-white/5"
        >
          Find us
        </a>
      </div>
    </div>
  </section>

</Base>

<style>
  .texture {
    background-image: repeating-linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0.03) 0px,
      rgba(255, 255, 255, 0.03) 1px,
      transparent 1px,
      transparent 10px
    );
  }

  /* Override RichText defaults for story body — larger line-height */
  .story-body :global(p) {
    margin-bottom: 1.6rem;
    line-height: 1.9;
  }
</style>
