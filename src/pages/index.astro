---
import Base from '@/components/layout/Base.astro';
import BusinessStatus from '@/components/shared/BusinessStatus.astro';
import GardenPlaceholder from '@/components/shared/GardenPlaceholder.astro';
import { businesses, statusMessage, enquiryLink, enquiryLabel, property } from '@/data/businesses';
---
<Base title="Welcome to Pokrom Eco Bar" description={`Nature · Taste · Experience. Discover Pokrom Eco Bar in Pokrom Nsabaa, Ghana. ${statusMessage('pokrom')}`}>
  <section class="home-hero wrap">
    <div class="hero-copy"><div class="hero-topline"><span class="eyebrow">A little closer to nature</span><BusinessStatus /></div>
      <h1>Welcome to<br /><span>Pokrom</span> <em>Eco Bar</em></h1>
      <p class="brand-tagline">Nature <span>·</span> Taste <span>·</span> Experience</p>
      <p class="hero-description">Discover refreshing drinks, local flavours and memorable moments in a relaxing garden atmosphere.</p>
      <div class="actions"><a class="button" href="/menu">Explore food & drinks <span aria-hidden="true">↗</span></a><a class="text-link" href={property.maps} target="_blank" rel="noopener noreferrer">Get directions ↗</a></div>
      <p class="hero-status">{statusMessage('pokrom')}</p><a class="text-link" href={enquiryLink('pokrom')} target="_blank" rel="noopener noreferrer">{enquiryLabel('pokrom')} {property.whatsapp ? 'on WhatsApp' : 'by email'} ↗</a>
    </div>
    <div class="hero-visual"><GardenPlaceholder label="An evening in the garden" variant="hero-art" /><div class="hero-location"><span aria-hidden="true">⌖</span><span>Pokrom Nsabaa, Ghana<br /><small>Your next favourite gathering place</small></span><span aria-hidden="true">↗</span></div></div>
  </section>
  <div class="experience-ribbon"><span>Rooted in nature</span><i>✳</i><span>Made for good company</span><i>✳</i><span>A taste of Pokrom</span></div>
  <section class="section wrap story-grid" id="pokrom"><div><p class="eyebrow">The Pokrom experience</p><h2>Come for a drink.<br /><em>Stay for the feeling.</em></h2></div><div class="prose"><p>Fresh air, good food and a table with your favourite people. Pokrom Eco Bar brings food, drinks and time together into the garden.</p><p>From an easy afternoon to a relaxed evening, we’re creating a welcoming outdoor space to slow down and enjoy the moment.</p><a class="text-link" href="/restaurant">Get to know Pokrom ↗</a></div></section>
  <section class="offer-section"><div class="wrap section"><div class="section-heading"><div><p class="eyebrow">Food, drinks & good company</p><h2>A little of what’s <em>to come.</em></h2></div><a class="text-link" href="/menu">Explore the menu ↗</a></div><div class="three-grid">{[{ no: '01', title: 'Raise a glass', text: 'Cocktails, beer, spirits and non-alcoholic drinks. Our confirmed selection will be shared soon.' },{ no: '02', title: 'Gather around', text: 'Local flavours, grills and special dishes are part of the plan. The final menu is on its way.' },{ no: '03', title: 'Make time for nature', text: 'A garden setting for conversation, connection and a slower pace.' }].map(item => <article class="experience-card"><span class="card-number">{item.no}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div><p class="small-note">Menu coming soon. Dishes, prices and availability will be published once confirmed.</p></div></section>
  <section class="section wrap"><div class="section-heading"><div><p class="eyebrow">Around the garden</p><h2>A space to <em>settle into.</em></h2></div><a class="text-link" href="/gallery">Explore the gallery ↗</a></div><div class="three-grid gallery-preview"><GardenPlaceholder label="The garden" /><GardenPlaceholder label="The bar & seating" variant="warm" /><GardenPlaceholder label="The atmosphere" variant="olive" /></div></section>
  <section class="stays-band"><div class="wrap stays-grid"><div><img src="/brand/pokhills-logo-transparent.webp" alt="Pokhills Eco Garden" width="110" height="110" loading="lazy" /><p class="eyebrow">A different way to enjoy the garden</p><h2>Stay a little longer.<br /><em>Someday soon.</em></h2></div><div><BusinessStatus business="pokhills" /><h3>Pokhills Eco Garden</h3><p>Our separate accommodation experience, at the same garden destination. A place to retreat into nature is taking shape.</p><p>{statusMessage('pokhills')}</p><a class="button button-light" href="/rooms">Discover Pokhills Stays ↗</a></div></div></section>
  <section class="section wrap visit-strip"><div><p class="eyebrow">Find your way here</p><h2>We’ll meet you <em>in the garden.</em></h2><p>{property.address}</p><p class="small-note">{businesses.pokrom.hours ?? 'Opening hours will be announced once confirmed.'}</p></div><div class="actions"><a class="button" href={property.maps} target="_blank" rel="noopener noreferrer">Get directions ↗</a><a class="text-link" href="/contact">Contact us ↗</a></div></section>
</Base>
