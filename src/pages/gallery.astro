---
import Base from '@/components/layout/Base.astro';
import SectionLabel from '@/components/shared/SectionLabel.astro';
import PlaceholderImage from '@/components/shared/PlaceholderImage.astro';
import GalleryLightbox from '@/components/gallery/GalleryLightbox';
import { getGallery } from '@/lib/api';

const images = await getGallery();

// Category → placeholder tone mapping
const tone: Record<string, 'green' | 'ochre' | 'stone'> = {
  rooms:    'green',
  food:     'ochre',
  bar:      'ochre',
  ambience: 'green',
  events:   'stone',
};

const categories = ['All', 'Rooms', 'Food', 'Bar', 'Ambience'];
---

<Base
  title="Gallery — Pokhills Eco Garden"
  description="Photography from Pokhills Eco Garden — rooms, garden, food, and the bar."
>

  <!-- 1. Hero -->
  <section class="relative flex flex-col items-center justify-center min-h-[30vh] bg-green-deep overflow-hidden px-6 text-center">
    <div class="texture absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="relative z-10 flex flex-col items-center gap-4 py-16">
      <SectionLabel text="The estate" color="cream" />
      <h1 class="font-display font-normal text-[40px] md:text-[46px] leading-[1.1] text-cream">
        The estate in pictures
      </h1>
      <p class="font-display italic text-[17px] text-stone/80">
        Rooms, garden, food, and the people in between
      </p>
    </div>
  </section>

  <!-- 2. Filter + gallery -->
  <section class="bg-cream pt-12 pb-20 px-6">
    <div class="max-w-6xl mx-auto">

      <!-- Category filter buttons -->
      <div class="flex flex-wrap gap-2 mb-10" role="group" aria-label="Filter by category">
        {categories.map((cat, i) => (
          <button
            data-filter={cat.toLowerCase()}
            class:list={[
              'filter-btn font-body text-[10px] uppercase tracking-[0.14em] px-4 py-2 rounded-sm border transition-colors duration-150',
              i === 0
                ? 'bg-ochre text-cream border-ochre'
                : 'bg-transparent text-muted border-stone/40 hover:border-ochre hover:text-ochre',
            ]}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Masonry grid -->
      <div id="gallery-grid" class="masonry-grid">
        {images.map((image, i) => (
          <div
            class="masonry-item reveal group cursor-pointer"
            data-category={image.category}
            data-index={i}
            data-reveal="fade"
            data-reveal-delay={String((i % 3) * 100)}
          >
            {image.url ? (
              <img
                src={image.url}
                alt={image.caption ?? ''}
                loading="lazy"
                class="w-full block object-cover rounded-sm transition-opacity duration-200 group-hover:opacity-85"
              />
            ) : (
              <div class="rounded-sm overflow-hidden">
                <PlaceholderImage
                  tone={tone[image.category] ?? 'green'}
                  aspect="4/3"
                  label={image.caption ?? 'Photo coming soon'}
                />
              </div>
            )}
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Lightbox island — listens for gallery:open custom event -->
  <GalleryLightbox images={images} client:load />

</Base>

<style>
  .texture {
    background-image: repeating-linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0.03) 0px,
      rgba(255, 255, 255, 0.03) 1px,
      transparent 1px,
      transparent 10px
    );
  }

  .masonry-grid {
    column-count: 3;
    column-gap: 12px;
  }

  .masonry-item {
    display: inline-block;
    width: 100%;
    margin-bottom: 12px;
    break-inside: avoid;
  }

  @media (max-width: 768px) {
    .masonry-grid { column-count: 2; }
  }

  @media (max-width: 480px) {
    .masonry-grid { column-count: 1; }
  }
</style>

<script>
  // ── Filter ────────────────────────────────────────────────────────────────
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.masonry-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'all';

      // Update active button styles
      filterBtns.forEach(b => {
        const active = b === btn;
        b.classList.toggle('bg-ochre', active);
        b.classList.toggle('text-cream', active);
        b.classList.toggle('border-ochre', active);
        b.classList.toggle('bg-transparent', !active);
        b.classList.toggle('text-muted', !active);
        b.classList.toggle('border-stone/40', !active);
      });

      // Show/hide items
      items.forEach(item => {
        const match = filter === 'all' || item.dataset.category === filter;
        item.style.display = match ? 'inline-block' : 'none';
      });
    });
  });

  // ── Lightbox trigger ──────────────────────────────────────────────────────
  items.forEach(item => {
    item.addEventListener('click', () => {
      const index = Number(item.dataset.index);
      window.dispatchEvent(new CustomEvent('gallery:open', { detail: { index } }));
    });
  });
</script>
