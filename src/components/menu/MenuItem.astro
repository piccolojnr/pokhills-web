---
import type { MenuItem as MenuItemType } from '@/lib/types';
import SmartImage from '@/components/shared/SmartImage.astro';
import { formatGHS } from '@/lib/utils';

interface Props {
  item: MenuItemType;
}

const { item } = Astro.props;
---

<div class="flex items-start gap-4 py-4 border-b border-stone/20 last:border-b-0">

  <!-- Image — only rendered when present -->
  {item.image && (
    <div class="shrink-0 w-16 h-16 rounded-sm overflow-hidden">
      <SmartImage
        src={item.image}
        alt={item.name}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </div>
  )}

  <!-- Text block -->
  <div class="flex-1 min-w-0">
    <div class="flex items-start justify-between gap-3">
      <!-- Name + badge -->
      <div class="flex items-center gap-2 flex-wrap">
        <span class="font-body font-medium text-[15px] text-bark leading-snug">
          {item.name}
        </span>
        {item.featured && (
          <span class="inline-block font-body text-[8px] uppercase tracking-[0.14em] text-ochre border border-ochre/50 px-[8px] py-[2px] rounded-full leading-none whitespace-nowrap">
            Chef's pick
          </span>
        )}
      </div>
      <!-- Price -->
      <span class="font-display text-[18px] text-ochre leading-none shrink-0 mt-0.5">
        {formatGHS(item.price)}
      </span>
    </div>
    {item.description && (
      <p class="font-body font-light text-[13px] text-muted leading-relaxed mt-1">
        {item.description}
      </p>
    )}
  </div>

</div>
