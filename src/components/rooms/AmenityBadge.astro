---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span class="inline-flex items-center gap-1.5 bg-stone/30 text-bark font-body text-[11px] px-3 py-1.5 rounded-sm">
  <svg
    width="12"
    height="12"
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
    class="shrink-0 text-ochre"
  >
    <path
      d="M12 22V12m0 0C12 7 7 3 2 3c0 5 4 9 10 9zm0 0c0-5 5-9 10-9-1 5-5 9-10 9"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  {label}
</span>
