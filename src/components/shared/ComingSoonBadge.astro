---
interface Props {
  text?: string;
}

const { text = 'Coming soon' } = Astro.props;
---

<span class="inline-block font-body text-[8px] font-normal uppercase tracking-[0.14em] text-ochre border border-ochre/50 bg-transparent px-[10px] py-1 rounded-full leading-none whitespace-nowrap">
  {text}
</span>
