---
interface Props {
  fill?: string;
}

const { fill = '#F5F0E8' } = Astro.props;
---

<div class="block leading-none overflow-hidden" aria-hidden="true">
  <svg
    viewBox="0 0 1440 40"
    xmlns="http://www.w3.org/2000/svg"
    preserveAspectRatio="none"
    class="block w-full"
    height="40"
  >
    <path
      d="M0,20 C180,40 360,0 540,18 C720,36 900,4 1080,20 C1260,36 1350,10 1440,18 L1440,40 L0,40 Z"
      fill={fill}
    />
  </svg>
</div>
