---
interface Props {
  roomCount: number;
}

const { roomCount } = Astro.props;

const stats = [
  { value: String(roomCount), label: 'Boutique rooms' },
  { value: '2',               label: 'Dining experiences' },
  { value: '1',               label: 'Garden estate' },
  { value: 'Ghana',           label: 'West Africa' },
];
---

<div class="bg-stone grid grid-cols-2 md:grid-cols-4 divide-x divide-ochre/20">
  {stats.map(({ value, label }) => (
    <div class="flex flex-col items-center gap-1.5 py-10 px-4 text-center">
      <span class="font-display text-[32px] font-normal leading-none text-bark">{value}</span>
      <span class="font-body text-[10px] uppercase tracking-[0.15em] text-muted">{label}</span>
    </div>
  ))}
</div>
