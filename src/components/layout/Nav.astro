---
import { statusLabel } from '@/data/businesses';
import PokromBrand from '@/components/shared/PokromBrand.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { label: 'Home', href: '/' }, { label: 'Pokrom Eco Bar', href: '/restaurant' },
  { label: 'Food & Drinks', href: '/menu' }, { label: 'Gallery', href: '/gallery' },
  { label: 'Pokhills Stays', href: '/rooms' }, { label: 'Contact', href: '/contact' },
];
---
<a href="#main-content" class="skip-link">Skip to content</a>
<header class:list={['launch-nav', { 'header-over-hero': path === '/' }]}>
  <a class="pokrom-brand-link" href="/" aria-label="Pokrom Eco Bar home"><PokromBrand /></a>
  <button class="mobile-menu-toggle" aria-expanded="false" aria-controls="primary-nav">Menu <span aria-hidden="true">☰</span></button>
  <nav id="primary-nav" class="primary-nav" aria-label="Primary navigation">
    {links.map(({ label, href }) => <a href={href} class:list={{ 'nav-contact': href === '/contact' }} aria-current={(href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined}>{label}{href === '/rooms' && <small class="nav-status">{statusLabel('pokhills')}</small>}</a>)}
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
  const nav = document.querySelector<HTMLElement>('#primary-nav');
  const header = document.querySelector<HTMLElement>('.launch-nav');
  const hero = document.querySelector<HTMLElement>('.home-hero');
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('is-open', open);
    header?.classList.toggle('menu-open', open);
  };
  const updateHeader = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 40);
    document.body.classList.toggle('hero-visible', !!hero && window.scrollY < hero.offsetHeight);
  };
  window.addEventListener('scroll', updateHeader, { passive: true });
  window.addEventListener('pageshow', updateHeader);
  updateHeader();
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); } });
  document.addEventListener('click', e => { if (e.target instanceof Node && !document.querySelector('.launch-nav')?.contains(e.target)) setOpen(false); });
</script>
