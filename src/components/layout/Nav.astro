---
import { statusLabel } from '@/data/businesses';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { label: 'Home', href: '/' }, { label: 'Pokrom Eco Bar', href: '/restaurant' },
  { label: 'Food & Drinks', href: '/menu' }, { label: 'Gallery', href: '/gallery' },
  { label: 'Pokhills Stays', href: '/rooms' }, { label: 'Contact', href: '/contact' },
];
---
<a href="#main-content" class="skip-link">Skip to content</a>
<header class="launch-nav">
  <a class="pokrom-wordmark" href="/" aria-label="Pokrom Eco Bar home"><span>POKROM</span><small>ECO BAR</small></a>
  <button class="mobile-menu-toggle" aria-expanded="false" aria-controls="primary-nav">Menu <span aria-hidden="true">☰</span></button>
  <nav id="primary-nav" class="primary-nav" aria-label="Primary navigation">
    {links.map(({ label, href }) => <a href={href} aria-current={(href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined}>{label}{href === '/rooms' && <small class="nav-status">{statusLabel('pokhills')}</small>}</a>)}
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
  const nav = document.querySelector<HTMLElement>('#primary-nav');
  const setOpen = (open: boolean) => { toggle?.setAttribute('aria-expanded', String(open)); nav?.classList.toggle('is-open', open); };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); } });
  document.addEventListener('click', e => { if (e.target instanceof Node && !document.querySelector('.launch-nav')?.contains(e.target)) setOpen(false); });
</script>
