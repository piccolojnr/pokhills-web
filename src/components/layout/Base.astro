---
import "@/styles/global.css";
import "@/styles/hero.css";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import WhatsAppButton from "../shared/WhatsAppButton.astro";
import { property, statusMessage } from '@/data/businesses';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Discover Pokrom Eco Bar in Pokrom Nsabaa, Ghana. Nature, taste and experience. Pokhills Eco Garden accommodation is coming soon.",
  ogImage = "/brand/pokrom-social.png",
  canonical,
  noindex = false,
} = Astro.props;

const fullTitle = `${title} | Pokrom Eco Bar & Pokhills Eco Garden`;
const canonicalURL = canonical
  ? new URL(canonical, Astro.site)
  : new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>

    <!-- Robots -->
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />

    <!-- SEO -->
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Pokrom Eco Bar & Pokhills Eco Garden" />
    <meta property="og:image:alt" content="Pokrom Eco Bar — Nature · Taste · Experience" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Theme colour -->
    <meta name="theme-color" content="#1B3B24" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@graph': [
        { '@type': 'WebSite', '@id': new URL('/#website', Astro.site).href, url: Astro.site?.href, name: 'Pokrom Eco Bar & Pokhills Eco Garden' },
        { '@type': 'BarOrPub', '@id': new URL('/restaurant#business', Astro.site).href, name: 'Pokrom Eco Bar', url: new URL('/restaurant', Astro.site).href, address: property.address, description: statusMessage('pokrom') },
        { '@type': 'Organization', '@id': new URL('/rooms#business', Astro.site).href, name: 'Pokhills Eco Garden', url: new URL('/rooms', Astro.site).href, description: statusMessage('pokhills'), logo: new URL('/brand/pokhills-logo-transparent.webp', Astro.site).href },
      ],
    }).replace(/</g, '\\u003c')} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />

    <!-- Font preloads — Cormorant Garamond (above-the-fold weights) -->
    <link rel="preload" href="/fonts/CormorantGaramond-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/CormorantGaramond-Italic.ttf" as="font" type="font/ttf" crossorigin />

    <!-- Font preloads — DM Sans -->
    <link rel="preload" href="/fonts/DMSans-Regular.ttf" as="font" type="font/ttf" crossorigin />

    <!-- Critical inline CSS — prevents FOUC on hero text before fonts load -->
    <style>
      :root {
        --font-display: 'Cormorant Garamond', Georgia, serif;
        --font-body: 'DM Sans', system-ui, sans-serif;
      }
      body {
        font-family: var(--font-body);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      h1, h2, h3, h4 {
        font-family: var(--font-display);
        font-weight: 400;
      }
    </style>
  </head>
  <body>
    <Nav />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <script>
      import '@/scripts/reveal';
    </script>
    {import.meta.env.DEV && import.meta.env.PUBLIC_API_MODE === 'demo' && (
      <div style="position:fixed;bottom:0;left:0;right:0;z-index:9999;padding:4px 12px;display:flex;align-items:center;justify-content:center;background:#3D2B1A;color:#B8A898;font-family:system-ui,sans-serif;font-size:10px;letter-spacing:0.05em;opacity:0.85;">
        Demo mode &mdash; mock data &middot; set <code style="margin:0 4px;font-size:10px;">PUBLIC_API_MODE=live</code> for real API
      </div>
    )}
  </body>
</html>
