---
const whatsapp = import.meta.env.PUBLIC_WHATSAPP ?? '+233000000000';
const waHref = `https://wa.me/${whatsapp.replace(/\D/g, '')}`;
---

<footer class="bg-bark text-stone font-body">
  <div class="max-w-5xl mx-auto px-6 pt-16 pb-12 grid grid-cols-1 sm:grid-cols-3 gap-10 sm:gap-8">

    <!-- Col 1: Brand -->
    <div class="flex flex-col gap-3">
      <a href="/" class="flex items-center gap-2.5 leading-none" aria-label="Pokhills Eco Garden">
        <img
          src="/brand/pokhills-logo-transparent.webp"
          alt="Pokhills Eco Garden logo"
          width="40"
          height="40"
          class="h-10 w-auto flex-shrink-0"
          class="h-10 w-10 rounded-full object-cover flex-shrink-0"
        />
        <span class="font-display font-medium text-xl text-cream tracking-[0.02em]">Pokhills</span
        ><span class="font-display font-normal italic text-xl text-stone tracking-[0.02em]"> Eco Garden</span>
      </a>
      <p class="text-[13px] leading-relaxed text-muted">
        One estate. A bar and kitchen.<br />A garden retreat. Ghana.
      </p>
      <div class="flex gap-3.5 mt-1">
        <!-- Instagram -->
        <a
          href="https://instagram.com/pokhillsecogarden"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="text-ochre transition-colors duration-150 hover:text-ochre-light"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
          </svg>
        </a>
        <!-- Facebook -->
        <a
          href="https://facebook.com/pokhillsecogarden"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="text-ochre transition-colors duration-150 hover:text-ochre-light"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Col 2: Explore -->
    <div class="flex flex-col gap-3">
      <p class="text-[10px] font-normal uppercase tracking-[0.2em] text-ochre mb-1">Explore</p>
      <nav class="flex flex-col gap-2" aria-label="Footer navigation">
        <a href="/rooms"      class="text-sm text-stone transition-colors duration-150 hover:text-cream">Rooms</a>
        <a href="/restaurant" class="text-sm text-stone transition-colors duration-150 hover:text-cream">Restaurant</a>
        <a href="/menu"       class="text-sm text-stone transition-colors duration-150 hover:text-cream">Menu</a>
        <a href="/gallery"    class="text-sm text-stone transition-colors duration-150 hover:text-cream">Gallery</a>
        <a href="/about"      class="text-sm text-stone transition-colors duration-150 hover:text-cream">About</a>
      </nav>
    </div>

    <!-- Col 3: Find us -->
    <div class="flex flex-col gap-3">
      <p class="text-[10px] font-normal uppercase tracking-[0.2em] text-ochre mb-1">Find us</p>
      <address class="not-italic flex flex-col gap-3 text-sm leading-relaxed">
        <p>Pokrom, Eastern Region<br />Ghana</p>
        <p class="text-muted">Tue – Fri 11am – 10pm<br />Sat – Sun 9am – 11pm</p>
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-ochre text-[13px] transition-colors duration-150 hover:text-ochre-light"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
          </svg>
          WhatsApp us
        </a>
      </address>
    </div>

  </div>

  <!-- Bottom bar -->
  <div class="border-t border-[#2A2A22] py-5 px-6 text-center">
    <p class="text-[11px] text-muted tracking-[0.04em]">© {new Date().getFullYear()} Pokhills Eco Garden · Built in Ghana</p>
  </div>
</footer>
